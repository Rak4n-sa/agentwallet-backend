# ══════════════════════════════════════════════════════════════════════════════
# AgentWallet — Environment Variables
# انسخ هذا الملف إلى .env واملأ القيم
# cp .env.example .env
# ══════════════════════════════════════════════════════════════════════════════

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
APP_URL=http://localhost:3000

# ── Supabase ──────────────────────────────────────────────────────────────────
# Project Settings → API في لوحة Supabase
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ── Wallet Mode ───────────────────────────────────────────────────────────────
# mock    → عناوين وهمية بدون blockchain (المرحلة الحالية)
# erc4337 → Base Sepolia/Mainnet عبر Pimlico (بعد MVP)
WALLET_MODE=mock

# ── Pimlico — ERC-4337 Bundler + Paymaster (بعد MVP فقط) ─────────────────────
# احصل عليها من: dashboard.pimlico.io
BUNDLER_URL=https://api.pimlico.io/v2/base-sepolia/rpc?apikey=your-key
EXECUTOR_PRIVATE_KEY=your-private-key-here

# ── Onramper ──────────────────────────────────────────────────────────────────
# احصل عليها من: onramper.com/dashboard
ONRAMPER_API_KEY=your-onramper-api-key
ONRAMPER_WEBHOOK_SECRET=your-onramper-webhook-secret
